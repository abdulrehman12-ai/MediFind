# MediFind local Compose variable names.
# Copy to infra/local.secrets (gitignored) and replace placeholder values.
# Never commit real passwords, APP_KEY, or Redis credentials.

APP_NAME=MediFind
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_URL=http://127.0.0.1:8080
APP_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=medifind
DB_USERNAME=medifind_dev
DB_PASSWORD=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_APP_PASSWORD=
POSTGRES_TEST_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TEST_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=dev@medifind.local
MAIL_FROM_NAME=MediFind

BUSINESS_TIMEZONE=Asia/Karachi

# Independent from APP_KEY and from OTP_TEST_HMAC_KEY. Development runtime only.
OTP_HMAC_KEY=
# Independent from APP_KEY and from OTP_HMAC_KEY. The phpunit service receives this value as OTP_HMAC_KEY.
OTP_TEST_HMAC_KEY=
SMS_OTP_PROVIDER=local
LOCAL_OTP_CODE=

# Amazon S3 prescription storage. Do not put real keys in Git.
# Leave these empty here. Tests use the local prescriptions_testing disk and do not call AWS.
# These values do not provision a bucket. A deployed bucket still needs Block Public Access,
# TLS-only access, encryption at rest, Object Lock disabled, versioning disabled, access
# logging, and an IAM policy limited to the rx/ prefix. Rotate credentials in the
# deployment platform. Deployed environments should use an IAM role. For local development
# only, temporary credentials may be placed in infra/local.secrets.
PRESCRIPTION_BUCKET=
PRESCRIPTION_REGION=
PRESCRIPTION_ACCESS_KEY_ID=
PRESCRIPTION_SECRET_ACCESS_KEY=
# Shared secret for the local PDF worker. Use a random value outside this example.
PDF_WORKER_TOKEN=
PRESCRIPTION_RETENTION_DAYS=
